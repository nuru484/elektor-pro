# Backend origin the browser talks to (also feeds CSP connect-src and the
# results websocket origin).
NEXT_PUBLIC_API_URL=http://localhost:4040/api/v1

# Canonical site origin for SEO metadata, sitemap, robots, and OG cards.
# Optional: defaults to https://elektorpro.com - set it only when serving
# from another domain (e.g. a staging deployment).
NEXT_PUBLIC_BASE_URL=https://elektorpro.com

# Sentry error tracking. Leave the DSN unset locally and in CI: the SDK is
# then disabled and nothing is reported. Browser events go through the
# same-origin /monitoring tunnel, so the CSP connect-src needs no change.
NEXT_PUBLIC_SENTRY_DSN=
# Optional environment label on reported events; defaults to VERCEL_ENV, then
# NODE_ENV.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# Build-time only, for source map upload. Set all three on the deploy
# platform; when any is missing the build still passes and skips the upload.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
