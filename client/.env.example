# Backend origin the browser talks to (also feeds CSP connect-src and the
# results websocket origin).
NEXT_PUBLIC_API_URL=http://localhost:4040/api/v1

# Canonical site origin for SEO metadata, sitemap, robots, and OG cards.
# Optional: defaults to https://elektorpro.com - set it only when serving
# from another domain (e.g. a staging deployment).
NEXT_PUBLIC_BASE_URL=https://elektorpro.com
