              </td>
            </tr>
            <!-- Footer: who sent it and where to ask, nothing more. -->
            <tr>
              <td class="email-footer" align="center" style="background: <%= brand.surfaceAlt %>; border-top: 1px solid <%= brand.rule %>; padding: 20px 26px; text-align: center;">
                <p style="margin: 0; font-family: Helvetica, Arial, sans-serif; font-size: 12.5px; line-height: 1.6; color: <%= brand.ink %>;"><%= brandName %> &middot; <%= brandTagline %></p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
