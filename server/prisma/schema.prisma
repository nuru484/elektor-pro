// Elektor Pro - generic, customizable e-voting platform schema
// Single-organization deployment. Works for schools, companies, unions,
// associations - any body that runs elections. Constituency grouping is
// entirely optional: by default every eligible voter votes every portfolio.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ===========================================================================
// Enums
// ===========================================================================

enum Role {
  SUPER_ADMIN
  ADMIN
  AGENT
  CANDIDATE
  VOTER
  ACCREDITOR // election-day official: accreditation desk only
}

enum Status {
  ACTIVE
  INACTIVE
  SUSPENDED
  LOCKED
}

enum ElectionStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  PAUSED
  ENDED
  CANCELLED
  ARCHIVED
}

enum ResultsPolicy {
  LIVE // visible live to everyone allowed by role/grant
  ON_CLOSE // visible once the election ends
  MANUAL // visible only after a super-admin publishes
}

// Who may vote at all.
enum EligibilityMode {
  ALL_VOTERS // every registered voter is eligible (e.g. whole-org SRC election)
  /// Scoped to one or more groups (e.g. a departmental election): only voters
  /// belonging to an ElectionEligibility group can SEE or vote in the election.
  GROUPS
  ROLL // only voters explicitly assigned to the election
}

// Per-portfolio constituency scoping.
enum PortfolioEligibilityMode {
  ALL_VOTERS // everyone eligible for the election votes this portfolio (default)
  ANY_OF_GROUPS // voter must belong to at least one of the listed groups
  ALL_OF_GROUPS // voter must belong to all listed groups (cross-category AND)
}

enum VotingMethod {
  SINGLE_CHOICE // pick exactly one candidate
  MULTI_SELECT // pick up to maxSelections candidates
  YES_NO // approve / reject a single nominee (referendum)
}

enum OtpPurpose {
  VOTER_LOGIN
  STAFF_LOGIN // email-OTP second factor at staff login
  EMAIL_CHANGE // confirm ownership of a new email address
  PHONE_CHANGE // confirm ownership of a new phone number
  TWO_FACTOR_EMAIL_ENABLE // confirm email before enabling email 2FA
}

enum TwoFactorMethod {
  TOTP // authenticator app (RFC 6238)
  EMAIL // one-time code sent to the account email
}

enum BallotEntryType {
  VOTE
  SKIP
  ABSTAIN
}

enum ChangeAction {
  CREATE
  UPDATE
  DELETE
}

enum ChangeStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  APPLIED
  FAILED
}

enum ChangeEntity {
  ORGANIZATION
  ELECTION
  PORTFOLIO
  CANDIDATE
  VOTER
  AGENT
  USER
  GROUP_CATEGORY
  GROUP
}

enum Capability {
  VIEW_RESULTS
  MANAGE_ELECTIONS
  MANAGE_PORTFOLIOS
  MANAGE_CANDIDATES
  MANAGE_VOTERS
  MANAGE_AGENTS
  MANAGE_GROUPS
  MANAGE_ORGANIZATION
  APPROVE_CHANGES
  CERTIFY_RESULTS
  ACCREDIT_VOTERS
  /// Score nominations and decide qualification (vetting panel).
  VET_CANDIDATES
}

/// Nomination lifecycle. Elections without vetting create candidates directly
/// as QUALIFIED; vetting-enabled elections start them as DRAFT and only
/// QUALIFIED candidates ever appear on ballots or in results.
enum CandidateStatus {
  DRAFT
  UNDER_REVIEW
  QUALIFIED
  DISQUALIFIED
  WITHDRAWN
}

// ===========================================================================
// Organization (singleton) - branding & default settings for the deployment
// ===========================================================================

model Organization {
  id           String  @id @default(cuid())
  name         String
  logoUrl      String?
  faviconUrl   String?
  supportEmail String?
  supportPhone String?
  website      String?
  // Retired: nothing reads these any more. The columns stay until a later
  // migration drops them, so a rolling deploy never leaves the previous build
  // selecting a column that is already gone.
  slug         String  @unique
  primaryColor String  @default("#111827")
  accentColor  String  @default("#2563eb")
  timezone     String  @default("UTC")
  locale       String  @default("en")
  settings     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ===========================================================================
// Identity & auth
// ===========================================================================

model User {
  id             String  @id @default(cuid())
  firstName      String
  lastName       String
  email          String? @unique
  phone          String? @unique
  password       String?
  role           Role    @default(ADMIN)
  status         Status  @default(ACTIVE)
  profilePicture String?

  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?

  // Two-factor
  twoFactorEnabled Boolean          @default(false)
  twoFactorMethod  TwoFactorMethod? // set while 2FA is enabled
  totpSecret       String? // encrypted at rest
  /// Highest TOTP time-step already accepted for this account. A code is
  /// single-use: replaying one inside its ±1-step drift window is refused.
  totpLastCounter  Int?

  // Pending contact changes awaiting OTP confirmation
  pendingEmail String?
  pendingPhone String?

  // Lockout / login hardening
  failedLoginAttempts Int       @default(0)
  lockedAt            DateTime?
  lockedReason        String?
  unlockedById        String?
  unlockedBy          User?     @relation("UserUnlocker", fields: [unlockedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  unlockedUsers       User[]    @relation("UserUnlocker")
  lastLoginAt         DateTime?
  passwordChangedAt   DateTime?
  /// Set on admin-created accounts: the user must replace the generated
  /// temporary password before using the platform.
  mustChangePassword  Boolean   @default(false)

  createdById  String?
  creator      User?   @relation("UserCreator", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdUsers User[]  @relation("UserCreator")

  // Linked domain profiles
  voter           Voter?
  candidates      Candidate[]            @relation("CandidateAccount")
  agentLinks      AgentAssignment[]
  accreditorLinks AccreditorAssignment[]
  importBatches   ImportBatch[]          @relation("ImportBatchCreator")
  exportJobs      ExportJob[]            @relation("ExportRequester")

  // Governance / authored records
  electionsCreated   Election[]              @relation("ElectionCreator")
  changeRequestsMade ChangeRequest[]         @relation("ChangeRequester")
  changeReviews      ChangeRequest[]         @relation("ChangeReviewer")
  accessGrantsHeld   AccessGrant[]           @relation("GrantHolder")
  accessGrantsIssued AccessGrant[]           @relation("GrantIssuer")
  resultsCertified   ResultSnapshot[]        @relation("ResultsCertifier")
  candidateReviews   Candidate[]             @relation("CandidateReviewer")
  vettingScoresGiven VettingScore[]          @relation("VettingScorer")
  auditLogs          AuditLog[]              @relation("AuditActor")
  recoveryCodes      TwoFactorRecoveryCode[]
  passwordResets     PasswordResetToken[]
  otps               Otp[]
  sessions           Session[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([role])
  @@index([status])
  @@index([deletedAt])
  @@index([createdById])
}

model TwoFactorRecoveryCode {
  id       String    @id @default(cuid())
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId   String
  codeHash String
  usedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Otp {
  id         String     @id @default(cuid())
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId     String
  codeHash   String
  purpose    OtpPurpose @default(VOTER_LOGIN)
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int        @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

// A refresh-token session (one per signed-in device). The refresh JWT carries
// the session id; its current token's hash is stored here and ROTATED on every
// refresh, so a stolen older refresh token is dead on arrival and users can
// see and revoke their signed-in devices.
model Session {
  id        String @id @default(cuid())
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId    String
  tokenHash String @unique
  // The hash this session held immediately before the last rotation, and when
  // that rotation happened. Presenting the previous token within the grace
  // window is a concurrent refresh (two tabs racing the same expiry), not
  // theft - see rotateSession. Both are null until a session first rotates.
  previousTokenHash String?
  rotatedAt         DateTime?
  ipAddress         String?
  userAgent         String?
  lastUsedAt        DateTime  @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

// ===========================================================================
// Optional voter grouping (constituencies). Entirely admin-defined.
// ===========================================================================

model GroupCategory {
  id            String  @id @default(cuid())
  name          String  @unique // e.g. "Faculty", "Hall", "Level", "Region", "Chapter"
  code          String  @unique
  description   String?
  order         Int     @default(0)
  allowMultiple Boolean @default(false) // can a voter belong to >1 group here?

  groups Group[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([deletedAt])
}

model Group {
  id          String        @id @default(cuid())
  category    GroupCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  categoryId  String
  name        String
  code        String        @unique
  description String?
  // Optional hierarchy (e.g. Department under a Faculty).
  parent      Group?        @relation("GroupHierarchy", fields: [parentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  parentId    String?
  children    Group[]       @relation("GroupHierarchy")

  voterMemberships     VoterGroupMembership[]
  portfolioEligibility PortfolioEligibility[]
  electionEligibility  ElectionEligibility[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([categoryId, name])
  @@index([categoryId])
  @@index([parentId])
  @@index([deletedAt])
}

model VoterGroupMembership {
  id      String @id @default(cuid())
  voter   Voter  @relation(fields: [voterId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  voterId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  groupId String

  createdAt DateTime @default(now())

  @@unique([voterId, groupId])
  @@index([voterId])
  @@index([groupId])
}

// ===========================================================================
// Voters
// ===========================================================================

model Voter {
  id             String  @id @default(cuid())
  // Linked login account (role = VOTER); voters authenticate via phone OTP.
  user           User?   @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  userId         String? @unique
  name           String
  voterId        String  @unique // index / membership / registration number
  phoneNumber    String? @unique
  // Unique like phoneNumber: both are OTP login identifiers, and the email
  // fallback must resolve to exactly one voter.
  email          String? @unique
  profilePicture String?
  // Free-form org-specific attributes (staff id, year, etc.).
  metadata       Json?

  groupMemberships VoterGroupMembership[]
  voterElections   VoterElection[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([deletedAt])
  // Voter lookup is a `contains` + case-insensitive search (accreditation
  // desk, roll, register). A B-tree cannot serve that, so at register scale
  // every keystroke becomes a sequential scan. Trigram GIN indexes make these
  // index scans; pg_trgm is created by the accompanying migration.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([voterId(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([phoneNumber(ops: raw("gin_trgm_ops"))], type: Gin)
}

// ===========================================================================
// Elections
// ===========================================================================

model Election {
  id          String         @id @default(cuid())
  slug        String         @unique
  name        String
  description String?
  status      ElectionStatus @default(DRAFT)
  startDate   DateTime
  endDate     DateTime

  // Who may vote at all.
  eligibilityMode EligibilityMode @default(ALL_VOTERS)

  // Results governance
  resultsPolicy      ResultsPolicy @default(ON_CLOSE)
  resultsPublishedAt DateTime?
  certifiedAt        DateTime?
  certifiedById      String?

  // Lifecycle / integrity
  accreditationRequired Boolean @default(false)
  /// When on, new candidates enter as DRAFT and pass through the vetting
  /// panel; only QUALIFIED candidates reach the ballot.
  vettingEnabled        Boolean @default(false)
  /// Auto-decision threshold: once every criterion is scored, a candidate at
  /// or above this percentage of the maximum total auto-qualifies, below it
  /// auto-disqualifies. Null = decisions stay manual.
  vettingPassPercent    Int?
  /// Accreditation hands each voter a one-time sign-in code (for polling
  /// stations where SMS/email OTPs are impractical).
  voteCodeEnabled       Boolean @default(false)
  /// OPEN BALLOT. When on, each voter's ballot receipt is stored against
  /// their record so their console can replay what they voted.
  ///
  /// This is not a display preference, it is a change of election TYPE. The
  /// stored link means one join reconstructs how every named voter voted, so
  /// an election with this on is an open (roll-call) ballot, not a secret
  /// one - a legitimate choice for a board or committee vote, and the wrong
  /// one wherever a voter could be pressured. The ballot screen states which
  /// kind of election the voter is in BEFORE they cast, and turning this off
  /// purges the links already stored.
  voteVisibleToVoter    Boolean @default(false)
  isLocked              Boolean @default(false) // set on certification

  // Per-election role-based UI visibility + branding overrides (over org defaults).
  settings Json?

  createdById String?
  createdBy   User?   @relation("ElectionCreator", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  portfolios        Portfolio[]
  candidates        Candidate[]
  voterElections    VoterElection[]
  ballots           Ballot[]
  agentLinks        AgentAssignment[]
  accreditorLinks   AccreditorAssignment[]
  importBatches     ImportBatch[]
  exportJobs        ExportJob[]
  accessGrants      AccessGrant[]
  resultSnapshots   ResultSnapshot[]
  eligibilityGroups ElectionEligibility[]
  vettingCriteria   VettingCriterion[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status])
  @@index([deletedAt])
  @@index([startDate])
  @@index([endDate])
  @@index([createdById])
}

/// Election-level constituency scoping (EligibilityMode.GROUPS): which groups
/// may see and vote in an election. The election-level counterpart of
/// PortfolioEligibility - a departmental election lists its department group
/// here; SRC-style elections use ALL_VOTERS and have no rows.
model ElectionEligibility {
  id         String   @id @default(cuid())
  election   Election @relation(fields: [electionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  electionId String
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  groupId    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([electionId, groupId])
  // Voter-portal visibility: "elections any of my groups can see".
  @@index([groupId])
}

model Portfolio {
  id            String                   @id @default(cuid())
  name          String
  description   String?
  order         Int                      @default(0)
  votingMethod  VotingMethod             @default(SINGLE_CHOICE)
  maxSelections Int                      @default(1) // for MULTI_SELECT
  allowAbstain  Boolean                  @default(true)
  eligibility   PortfolioEligibilityMode @default(ALL_VOTERS)

  election   Election @relation(fields: [electionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  electionId String

  eligibilityGroups PortfolioEligibility[]
  candidates        Candidate[]
  ballotEntries     BallotEntry[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([electionId, name])
  @@index([electionId])
  @@index([deletedAt])
}

model PortfolioEligibility {
  id          String    @id @default(cuid())
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  portfolioId String
  group       Group     @relation(fields: [groupId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  groupId     String

  createdAt DateTime @default(now())

  @@unique([portfolioId, groupId])
  @@index([portfolioId])
  @@index([groupId])
}

model Candidate {
  id             String  @id @default(cuid())
  name           String
  profilePicture String?
  /// Campaign name / nickname (e.g. "Team Nuru") - organisational elections
  /// rarely have parties. Kept on the original "party" column via @map.
  nickname       String? @map("party")
  partySymbol    String?
  manifesto      String?
  /// Uploaded manifesto document (PDF), set only by the upload middleware.
  manifestoUrl   String?
  order          Int     @default(0)

  // Nomination lifecycle. Candidates on non-vetting elections default to
  // QUALIFIED, which puts them straight on the ballot.
  status       CandidateStatus @default(QUALIFIED)
  /// Position on the printed/on-screen ballot, unique within the portfolio.
  ballotNumber Int?
  /// Decision note from the vetting panel (why qualified/disqualified).
  vettingNote  String?
  reviewedBy   User?           @relation("CandidateReviewer", fields: [reviewedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  reviewedById String?
  reviewedAt   DateTime?

  vettingScores VettingScore[]

  // Optional login account for the candidate (role = CANDIDATE)
  account   User?   @relation("CandidateAccount", fields: [accountId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  accountId String?

  election    Election  @relation(fields: [electionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  electionId  String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  portfolioId String

  ballotEntries BallotEntry[]
  agentLinks    AgentAssignment[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Ballot positions are unique per portfolio (NULLs, i.e. unassigned, may repeat).
  @@unique([portfolioId, ballotNumber])
  @@index([electionId])
  @@index([portfolioId])
  @@index([accountId])
  // Vetting queue: candidates of an election filtered by lifecycle status.
  @@index([status])
  @@index([deletedAt])
}

/// One vetting yardstick for an election (e.g. "Academic standing", max 10).
model VettingCriterion {
  id          String   @id @default(cuid())
  election    Election @relation(fields: [electionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  electionId  String
  name        String
  description String?
  maxScore    Int      @default(10)
  order       Int      @default(0)

  scores VettingScore[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([electionId, name])
  @@index([electionId])
}

/// One panelist's score for one candidate on one criterion.
model VettingScore {
  id          String           @id @default(cuid())
  candidate   Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  candidateId String
  criterion   VettingCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  criterionId String
  score       Int
  note        String?
  scoredBy    User?            @relation("VettingScorer", fields: [scoredById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  scoredById  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // A panelist scores each candidate-criterion pair once (re-submits update).
  @@unique([candidateId, criterionId, scoredById])
  @@index([candidateId])
  @@index([criterionId])
}

// Agents observe results for a scope (an election, optionally a candidate).
model AgentAssignment {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId String

  election   Election @relation(fields: [electionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  electionId String

  candidate   Candidate? @relation(fields: [candidateId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  candidateId String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, electionId, candidateId])
  @@index([electionId])
  @@index([userId])
  @@index([deletedAt])
}

/// Which elections an accreditor may work. An ACCREDITOR holds the
/// ACCREDIT_VOTERS capability, but capability alone would let them work every
/// election in the organization - including ones they have no business
/// touching. Assignment is the scope: the desk only lists, and the server
/// only accepts, elections the accreditor has been put on.
/// How far a queued import has got. Progress lives in the database rather
/// than only in the job, so a worker restart resumes instead of restarting,
/// and the admin's progress bar survives a deploy.
enum ExportStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum ExportFormat {
  CSV
  PDF
}

/// A results export generated in the background and collected afterwards.
///
/// Small exports still stream straight back in the response. A large
/// election's PDF takes long enough to render that holding the request open
/// risks a proxy timeout and blocks a worker thread, so it becomes a job: the
/// file is written to disk, and this row is the handle - what it is, whether
/// it is ready, who may collect it, and when it expires.
///
/// `downloadToken` (not the id) is what the download URL carries: the id
/// appears in logs and admin UIs, so making it the credential would leak
/// results to anyone who read a log line.
model ExportJob {
  id     String       @id @default(cuid())
  status ExportStatus @default(PENDING)
  format ExportFormat

  election   Election @relation(fields: [electionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  electionId String

  /// Absolute path on the instance that generated it. Null until ready.
  filePath      String?
  /// What the browser should save it as.
  fileName      String?
  byteSize      Int?
  /// Single-use-ish secret in the download URL; unique so it can be looked up.
  downloadToken String  @unique
  error         String?

  requestedBy   User?   @relation("ExportRequester", fields: [requestedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  requestedById String?

  /// Swept after this; results should not sit on disk indefinitely.
  expiresAt   DateTime
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([electionId])
  @@index([expiresAt])
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  /// Finished, but some rows could not be written - see `errors`.
  PARTIAL
  FAILED
}

enum ImportKind {
  VOTER
  CANDIDATE
}

/// A large import, held as validated rows and written in chunks.
///
/// The direct bulk path writes every row in ONE transaction, which is correct
/// but caps the import: tens of thousands of rows would hold a transaction
/// open for minutes and time out. This model lets the write be split into
/// chunks that each commit on their own, with `processedRows` as the cursor -
/// so a crash mid-import resumes from where it stopped rather than starting
/// over or, worse, duplicating what it already wrote.
model ImportBatch {
  id     String       @id @default(cuid())
  kind   ImportKind
  status ImportStatus @default(PENDING)

  /// The validated rows, exactly as the preview approved them.
  rows Json

  totalRows     Int
  /// Advanced in the SAME transaction that writes its chunk, which is what
  /// makes a resumed import exactly-once per chunk.
  processedRows Int @default(0)
  createdRows   Int @default(0)
  failedRows    Int @default(0)

  /// Per-row failures: [{ row, message }]. Kept so an admin can fix and
  /// re-import only what did not land.
  errors Json?
  /// Set when the whole batch failed rather than individual rows.
  error  String?

  election   Election? @relation(fields: [electionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  electionId String?

  createdBy   User?   @relation("ImportBatchCreator", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdById String?

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([createdById])
  @@index([electionId])
}

model AccreditorAssignment {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId String

  election   Election @relation(fields: [electionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  electionId String

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, electionId])
  @@index([electionId])
  @@index([userId])
  @@index([deletedAt])
}

// ===========================================================================
// Voting (secret ballot)
// ===========================================================================

// Per-voter, per-election status: turnout, accreditation, one-person-one-vote
// guard. Deliberately NOT linked to a ballot, to preserve ballot secrecy.
model VoterElection {
  id         String   @id @default(cuid())
  voter      Voter    @relation(fields: [voterId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  voterId    String
  election   Election @relation(fields: [electionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  electionId String

  isEligible     Boolean   @default(true)
  accreditedAt   DateTime?
  accreditedById String?
  hasVoted       Boolean   @default(false)
  votedAt        DateTime?

  /// One-time voting code (hashed) issued at accreditation when the election
  /// enables codes - the polling-station sign-in for voters without phones.
  voteCodeHash     String?
  voteCodeIssuedAt DateTime?
  voteCodeUsedAt   DateTime?

  /// The voter's ballot receipt, stored ONLY for open-ballot elections
  /// (Election.voteVisibleToVoter). It is what lets their console replay what
  /// they voted - and equally what lets one join reconstruct how every named
  /// voter voted, which is why a secret-ballot election leaves it null and
  /// turning the setting off purges it.
  receiptCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([voterId, electionId])
  @@index([electionId])
  @@index([voterId])
}

// An anonymous ballot. The receipt code is shown to the voter once and lets
// them verify inclusion without us storing who they are.
model Ballot {
  id          String   @id @default(cuid())
  election    Election @relation(fields: [electionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  electionId  String
  receiptCode String   @unique
  // Tamper-evident hash chain over ballots within an election.
  sequence    Int
  prevHash    String
  hash        String   @unique
  castAt      DateTime @default(now())

  entries BallotEntry[]

  createdAt DateTime @default(now())

  @@unique([electionId, sequence])
  @@index([electionId])
}

model BallotEntry {
  id          String          @id @default(cuid())
  ballot      Ballot          @relation(fields: [ballotId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  ballotId    String
  portfolio   Portfolio       @relation(fields: [portfolioId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  portfolioId String
  candidate   Candidate?      @relation(fields: [candidateId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  candidateId String?
  type        BallotEntryType @default(VOTE)
  approve     Boolean? // YES_NO portfolios: true = yes, false = no

  createdAt DateTime @default(now())

  @@unique([ballotId, portfolioId, candidateId])
  @@index([ballotId])
  @@index([portfolioId])
  @@index([candidateId])
  @@index([type])
}

// ===========================================================================
// Governance: capability grants, change requests, certification, audit
// ===========================================================================

model AccessGrant {
  id         String     @id @default(cuid())
  user       User       @relation("GrantHolder", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId     String
  capability Capability
  election   Election?  @relation(fields: [electionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  electionId String?
  expiresAt  DateTime?
  revokedAt  DateTime?

  grantedById String?
  grantedBy   User?   @relation("GrantIssuer", fields: [grantedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, capability, electionId])
  @@index([userId])
  @@index([electionId])
}

/// Runtime role → capability grants, edited by super-admins from the console.
/// Seeded with the shipped defaults; the
/// capability service reads these behind a short cache. SUPER_ADMIN is never
/// stored - it implicitly holds every capability.
model RoleCapability {
  id         String     @id @default(cuid())
  role       Role
  capability Capability
  createdAt  DateTime   @default(now())

  @@unique([role, capability])
  @@index([role])
}

model ChangeRequest {
  id       String       @id @default(cuid())
  action   ChangeAction
  entity   ChangeEntity
  entityId String? // null for CREATE
  payload  Json // proposed data
  status   ChangeStatus @default(PENDING)
  summary  String?

  requestedById String
  requestedBy   User   @relation("ChangeRequester", fields: [requestedById], references: [id], onDelete: Cascade, onUpdate: Cascade)

  reviewedById String?
  reviewedBy   User?     @relation("ChangeReviewer", fields: [reviewedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  reviewedAt   DateTime?
  reviewNote   String?
  appliedAt    DateTime?
  resultId     String? // id of entity created/updated on apply
  error        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([entity, entityId])
  @@index([requestedById])
  @@index([createdAt])
}

model ResultSnapshot {
  id         String   @id @default(cuid())
  election   Election @relation(fields: [electionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  electionId String
  data       Json // full certified tally
  hash       String   @unique

  certifiedById String?
  certifiedBy   User?   @relation("ResultsCertifier", fields: [certifiedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  createdAt DateTime @default(now())

  @@index([electionId])
}

// Append-only, hash-chained audit trail.
model AuditLog {
  id        String  @id @default(cuid())
  sequence  Int     @unique @default(autoincrement())
  actor     User?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  actorId   String?
  actorRole Role?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  prevHash  String
  hash      String  @unique

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
}
