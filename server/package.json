{
  "name": "server",
  "version": "1.0.0",
  "description": "An advanced web based voting system api",
  "license": "ISC",
  "author": "Nurudeen Abdul-Majeed",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "tsx --watch --env-file .env server.ts",
    "start": "node dist/server.js",
    "build": "prisma generate && tsc -p tsconfig.build.json && npm run copy:assets",
    "migrate": "node --env-file .env ./node_modules/.bin/prisma migrate dev",
    "migrate:deploy": "node --env-file .env ./node_modules/.bin/prisma migrate deploy",
    "seed": "npx prisma db seed",
    "bootstrap": "tsx prisma/bootstrap.ts",
    "deploy": "npm ci --include=dev && npm run build",
    "postinstall": "prisma generate",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "studio": "prisma studio",
    "copy:assets": "cp -r src/ejs dist/src/ejs",
    "audit:ci": "node scripts/audit-gate.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sentry/node": "^10.69.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/ejs": "^3.1.5",
    "@types/jsonwebtoken": "^9.0.10",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.11",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "dotenv": "^17.4.2",
    "ejs": "^3.1.10",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.13.14",
    "multer": "^2.4.0",
    "otplib": "^13.5.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "posthog-node": "^5.55.0",
    "qrcode": "^1.5.4",
    "rate-limit-redis": "^6.0.1",
    "resend": "^6.32.0",
    "socket.io": "^4.8.4",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tsconfig/node22": "^22.0.6",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.13.3",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.4",
    "eslint-plugin-perfectionist": "^4.15.1",
    "prettier": "^3.9.9",
    "prisma": "^7.10.0",
    "supertest": "^7.3.1",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.10"
  },
  "imports": {
    "#*": "./src/*"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  }
}
