{
  "name": "server",
  "version": "1.0.0",
  "description": "An advanced web based voting system api",
  "license": "ISC",
  "author": "Nurudeen Abdul-Majeed",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "tsx --watch --env-file .env server.ts",
    "start": "tsx server.ts",
    "build": "prisma generate && tsc --noEmit",
    "migrate": "prisma migrate dev",
    "seed": "npx prisma db seed",
    "deploy": "npm install && prisma generate && prisma migrate deploy && npm run seed",
    "postinstall": "prisma generate",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "migrate:deploy": "prisma migrate deploy",
    "studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
