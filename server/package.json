    "libphonenumber-js": "^1.12.26",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.10",
    "otplib": "^12.0.1",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.2",
