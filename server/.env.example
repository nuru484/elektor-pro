NODE_ENV=development
PORT=4040

DATABASE_URL=
# Max connections in the shared pg pool (API + in-process workers). Default 20.
DB_POOL_MAX=

CORS_ACCESS=http://localhost:3000
# Client origin used in emailed links (password reset, invitations).
FRONTEND_URL=http://localhost:3000

# Minimum 32 characters each, enforced in production.
# Generate with: openssl rand -base64 48
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=30m
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY=7d
COOKIE_DOMAIN=

# Encrypts secrets at rest (TOTP secrets). REQUIRED in production, and kept
# SEPARATE from the token secrets on purpose: sharing them meant rotating
# ACCESS_TOKEN_SECRET silently made every stored TOTP secret undecryptable and
# locked out every 2FA user. Outside production this falls back to
# ACCESS_TOKEN_SECRET. Rotating it later still works (decryption falls back to
# the previous key), but do it deliberately.
ENCRYPTION_KEY=

# Voter OTP delivery: mock (logs OTP, no SMS) | live (sends via FROG)
OTP_MODE=mock
OTP_TTL_MINUTES=10
OTP_LENGTH=6
FROG_API_KEY=
FROG_SENDER_ID=sender id from sms service provider
FROG_USERNAME=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
GMAIL_USER=
GMAIL_PASSWORD=
SMTP_MAIL=

# Background jobs (BullMQ). Empty disables queues (dev without Redis).
REDIS_URL=

# Error tracking. Empty disables Sentry (dev, CI, tests).
SENTRY_DSN=

# Internal callers presenting this via X-Rate-Limit-Bypass skip rate limits.
# Leave empty to disable the bypass entirely.
RATE_LIMIT_BYPASS_SECRET=

# Bootstrap super admin (npm run bootstrap). The password is GENERATED and
# printed once - never read from the environment - and must be changed at
# first sign-in.
ADMIN_EMAIL=admin@elektorpro.com
ADMIN_FIRST_NAME=Super
ADMIN_LAST_NAME=Admin
ADMIN_PHONE=+233200000001
ORGANIZATION_NAME=Elektor Pro

# Development seed only (npm run seed). Refused when NODE_ENV=production.
SEED_PASSWORD=
