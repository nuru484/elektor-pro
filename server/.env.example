# Runtime configuration for the API process. CI/CD credentials are a separate
# thing and do NOT belong here: the deploy workflow reads RENDER_DEPLOY_HOOK_URL,
# PRODUCTION_DATABASE_URL, RENDER_API_KEY, RENDER_SERVICE_ID and
# RENDER_HEALTH_URL from the repository's GitHub `production` environment. See
# the README's "GitHub secrets the deploy needs".

NODE_ENV=development
PORT=4040

DATABASE_URL=
# Max connections in the shared pg pool (API + in-process workers). Default 20.
DB_POOL_MAX=

CORS_ACCESS=http://localhost:3000
# Client origin used in emailed links (password reset, invitations).
FRONTEND_URL=http://localhost:3000

# Minimum 32 characters each, enforced in production.
# Generate with: openssl rand -base64 48
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=30m
REFRESH_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRY=7d
COOKIE_DOMAIN=

# Encrypts secrets at rest (TOTP secrets). REQUIRED in production, and kept
# SEPARATE from the token secrets on purpose: sharing them meant rotating
# ACCESS_TOKEN_SECRET silently made every stored TOTP secret undecryptable and
# locked out every 2FA user. Outside production this falls back to
# ACCESS_TOKEN_SECRET. Rotating it later still works (decryption falls back to
# the previous key), but do it deliberately.
ENCRYPTION_KEY=

# Voter OTP delivery: mock (logs OTP, no SMS) | live (sends via FROG)
OTP_MODE=mock
OTP_TTL_MINUTES=10
OTP_LENGTH=6
FROG_API_KEY=
FROG_SENDER_ID=sender id from sms service provider
FROG_USERNAME=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional email (Resend HTTP API - works on hosts that block SMTP, e.g.
# Render's free tier). Empty key = mock mode: emails are logged, not sent.
RESEND_API_KEY=
# Sender address; must be on a domain verified in Resend.
MAIL_FROM="Elektor Pro <no-reply@manuru.dev>"

# Background jobs (BullMQ). Empty disables queues (dev without Redis) - the
# app still works, announcements just deliver inline without retries.
REDIS_URL=
# Notification worker tuning. Concurrency is how many messages are in flight
# at once; per-second is the ceiling, set to whatever the SMS/email
# provider actually allows so a blast is slowed rather than rate-limited into
# retries.
NOTIFICATION_CONCURRENCY=5
NOTIFICATION_PER_SECOND=10
# Large imports are written in chunks by a worker. With REDIS_URL unset they
# still run, just inline on the request instead of in the background.

# Where background-generated result exports are written. Must be writable by
# this process, and shared between instances when more than one runs - a file
# written by one instance is not readable by another. Files are swept 24h
# after generation.
EXPORT_DIR=./storage/exports

# Log verbosity (fatal | error | warn | info | debug | trace). Empty picks the
# default: info in production, debug elsewhere, silent under test.
LOG_LEVEL=

# Error tracking. Empty disables Sentry (dev, CI, tests).
SENTRY_DSN=
# Environment tag on Sentry events (production, staging). Defaults to NODE_ENV.
SENTRY_ENVIRONMENT=
# Fraction of requests traced for performance, 0 to 1. 0 (the default) sends
# errors only; 0.1 is enough to answer "is p95 degrading?".
SENTRY_TRACES_SAMPLE_RATE=0
# Release tag on events. Empty falls back to RENDER_GIT_COMMIT (set by Render),
# then to no release at all.
SENTRY_RELEASE=

# Product analytics (PostHog). Empty disables it (dev, CI, tests). Events are
# the audit-log actions keyed by the actor's opaque id, plus job outcomes;
# properties are masked with the same rules as error reports.
POSTHOG_API_KEY=
# EU cloud by default; https://us.i.posthog.com for a US project.
POSTHOG_HOST=https://eu.i.posthog.com

# Internal callers presenting this via X-Rate-Limit-Bypass skip rate limits.
# Leave empty to disable the bypass entirely.
RATE_LIMIT_BYPASS_SECRET=

# Bootstrap super admin, read ONLY by `npm run bootstrap` and `npm run seed`,
# which assert them themselves. Nothing else reads them, so a deployment does
# not need them at all. The password is GENERATED and printed once - never
# read from the environment - and must be changed at first sign-in.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_EMAIL=admin@elektorpro.com
ADMIN_FIRST_NAME=Super
ADMIN_LAST_NAME=Admin
ADMIN_PHONE=+233200000001
ORGANIZATION_NAME=Elektor Pro

# Development seed only (npm run seed). Refused when NODE_ENV=production.
SEED_PASSWORD=

# Demo sign-in. Off unless explicitly enabled. When on, POST
# /auth/demo-login signs a visitor in as the seeded account for a role -
# no credentials. The accounts are created by `npm run seed` with random
# passwords, so this endpoint is the only way into them.
DEMO_LOGIN_ENABLED=false
DEMO_SUPER_ADMIN_EMAIL=demo.superadmin@elektorpro.app
DEMO_ADMIN_EMAIL=demo.admin@elektorpro.app
DEMO_ACCREDITOR_EMAIL=demo.accreditor@elektorpro.app
DEMO_AGENT_EMAIL=demo.agent@elektorpro.app
DEMO_CANDIDATE_EMAIL=demo.candidate@elektorpro.app
DEMO_VOTER_ID=DEMO-VOTER-001
